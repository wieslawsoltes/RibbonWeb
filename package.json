{
  "name": "@wieslawsoltes/ribbon-web",
  "version": "0.1.0",
  "description": "Standalone ribbon Web Component with .NET-style commands, observable models, MVVM binding and RibbonX import.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./ribbonx": {
      "types": "./dist/ribbonx.d.ts",
      "import": "./dist/ribbonx.js",
      "default": "./dist/ribbonx.js"
    },
    "./dotnet": {
      "types": "./dist/dotnet.d.ts",
      "import": "./dist/dotnet.js",
      "default": "./dist/dotnet.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.d.ts",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "dotnet"
  ],
  "sideEffects": [
    "./src/index.js",
    "./src/ribbon.js",
    "./dist/index.js",
    "./dist/ribbon.js"
  ],
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build.mjs && node scripts/package.mjs && node scripts/build-site.mjs",
    "release:pack": "node scripts/build.mjs && node scripts/package.mjs",
    "release:validate": "node scripts/release-validate.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --lib ES2022,DOM tests/types.test.ts",
    "format": "prettier --write src examples scripts tests docs *.md *.json .github/workflows",
    "format:check": "prettier --check src examples scripts tests docs *.md *.json .github/workflows"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Wiesław Šoltés",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wieslawsoltes/RibbonWeb.git"
  },
  "homepage": "https://wieslawsoltes.github.io/RibbonWeb/",
  "bugs": {
    "url": "https://github.com/wieslawsoltes/RibbonWeb/issues"
  },
  "keywords": [
    "ribbon",
    "web-component",
    "custom-element",
    "mvvm",
    "dotnet",
    "ribbonx",
    "toolbar",
    "command",
    "accessible"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "playwright": "1.55.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
