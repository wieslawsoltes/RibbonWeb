<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion>
    <RootNamespace>RibbonWeb.Blazor</RootNamespace><AssemblyName>RibbonWeb.Blazor</AssemblyName><PackageId>RibbonWeb.Blazor</PackageId>
    <Authors>Wiesław Šoltés</Authors><Description>Self-contained Blazor ribbon components, ICommand integration and native RibbonWeb engine interop.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression><PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/wieslawsoltes/RibbonWeb</RepositoryUrl><RepositoryType>git</RepositoryType><PackageProjectUrl>https://github.com/wieslawsoltes/RibbonWeb/tree/main/blazor</PackageProjectUrl>
    <PackageTags>blazor;webassembly;ribbon;mvvm;components</PackageTags><IsPackable>true</IsPackable><Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols><SymbolPackageFormat>snupkg</SymbolPackageFormat><EmbedAllSources>true</EmbedAllSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile><NoWarn>$(NoWarn);CS1591</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <Import Project="../blazor/Version.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(BlazorFrameworkVersion)" />
    <Compile Include="../blazor/src/*.cs" Link="Interop/%(Filename)%(Extension)" />
    <None Include="../blazor/README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <Content Include="../src/*.js" Link="wwwroot/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../blazor/src/wwwroot/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="VerifyBrowserAssets" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../blazor/src/wwwroot/library.js')" Text="Initialize submodules, run npm ci, npm run build, and node blazor/build.mjs before building this source project. NuGet consumers do not need Node." />
  </Target>
</Project>
